{
    "name": "pepperfm/api-responder-for-laravel",
    "description": "Minimal, predictable JSON API responses for Laravel 13",
    "keywords": [
        "pepperfm",
        "laravel",
        "api",
        "json",
        "rest",
        "response",
        "api-responder"
    ],
    "homepage": "https://github.com/pepperfm/api-responder-for-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Dmitry Gaponenko",
            "email": "Damon3453@yandex.ru",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/http": "^13.0",
        "illuminate/pagination": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Pepperfm\\ApiResponder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pepperfm\\ApiResponder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
