{
    "name": "pepperfm/api-responder-for-laravel",
    "description": "Small, predictable JSON API responses for Laravel",
    "keywords": [
        "pepperfm",
        "laravel",
        "api",
        "json",
        "rest",
        "response",
        "api-responder"
    ],
    "homepage": "https://github.com/pepperfm/api-responder-for-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Dmitry Gaponenko",
            "email": "Damon3453@yandex.ru",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/pagination": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Pepperfm\\ApiBaseResponder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pepperfm\\ApiBaseResponder\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --coverage-html=coverage",
        "lint": [
            "@php vendor/bin/pint -v --test",
            "@php vendor/bin/php-cs-fixer check"
        ],
        "lint-hard": [
            "@php vendor/bin/pint -v",
            "@php vendor/bin/php-cs-fixer fix --diff -v"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pepperfm\\ApiBaseResponder\\Providers\\ApiBaseResponderServiceProvider"
            ],
            "aliases": {
                "ApiBaseResponder": "Pepperfm\\ApiBaseResponder\\Facades\\BaseResponse"
            }
        }
    }
}
